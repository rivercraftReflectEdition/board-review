{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board-review/datasheet_digest.schema.json",
  "title": "Datasheet digest",
  "description": "Facts from one datasheet, read from page images. Every entry cites a page. Values the documents do not give are listed under not_published. Values in SI units. source_unavailable records a missing document. model_unavailable records a missing manufacturer model; it can stand alone or appear in a readable digest's optional list.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"required": ["status"], "properties": {"status": {"const": "source_unavailable"}}},
      "then": {"required": ["mpn", "status", "unavailable"]},
      "else": {
        "if": {"required": ["status"], "properties": {"status": {"const": "model_unavailable"}}},
        "then": {
          "required": ["mpn", "status", "kind", "unavailable"]
        },
        "else": {
          "required": [
            "mpn", "manufacturer", "document", "read_from", "pins", "abs_max",
            "recommended_operating", "electrical", "equations", "layout_rules", "errata",
            "example_envelope", "not_published"
          ]
        }
      }
    },
    {
      "if": {"required": ["status"], "properties": {"status": {"const": "model_unavailable"}}},
      "then": {"properties": {"unavailable": {"$ref": "#/$defs/model_unavailable_detail"}}},
      "else": {"properties": {"unavailable": {"$ref": "#/$defs/source_unavailable_detail"}}}
    }
  ],
  "properties": {
    "mpn": {"type": "string", "minLength": 2},
    "manufacturer": {"type": "string"},
    "function": {"type": "string", "description": "One line, for example 'dual 3 A synchronous buck, valley current mode'."},
    "status": {"enum": ["draft", "reviewed", "source_unavailable", "model_unavailable"], "description": "source_unavailable: no datasheet was read. model_unavailable: a required manufacturer model could not be obtained. Neither means a value is not published."},
    "unavailable": {"type": "object"},
    "kind": {"enum": ["touchstone", "ibis", "spice"], "description": "Requested model type for a standalone model_unavailable record."},
    "required_conditions": {"$ref": "#/$defs/model_conditions"},
    "model_unavailable": {"type": "array", "items": {"$ref": "#/$defs/model_unavailable"}, "description": "Unavailable models beside an otherwise readable datasheet digest."},
    "clock_io": {"type": "array", "items": {"$ref": "#/$defs/clock_io"}},
    "psrr": {"type": "array", "items": {"$ref": "#/$defs/spec"}, "description": "PSRR or PSMR with frequency, rail, bias, amplitude convention and sign in conditions; digitized curves go in curves."},
    "rf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "band_hz": {"$ref": "#/$defs/range"},
        "conditions": {"type": "string"},
        "page": {"$ref": "#/$defs/page"},
        "touchstone": {"type": "array", "items": {"$ref": "#/$defs/model_reference"}}
      }
    },
    "converter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clock_input": {"$ref": "#/$defs/clock_io"},
        "input_common_mode_v": {"$ref": "#/$defs/range"},
        "reference_caps": {"type": "array", "items": {"$ref": "#/$defs/spec"}},
        "jesd": {"type": "array", "items": {"$ref": "#/$defs/jesd"}},
        "page": {"$ref": "#/$defs/page"}
      }
    },
    "reviewed_by": {"type": "string"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "revision"],
      "properties": {
        "number": {"type": "string"},
        "revision": {"type": "string"},
        "date": {"type": "string"},
        "title": {"type": "string"},
        "url": {"type": "string"},
        "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "related_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "number"],
        "properties": {
          "kind": {"enum": ["errata", "app_note", "reference_design", "eval_board", "user_manual", "model", "reliability"]},
          "number": {"type": "string"},
          "revision": {"type": "string"},
          "title": {"type": "string"}
        }
      }
    },
    "read_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "pages_read"],
      "properties": {
        "method": {"const": "page_images", "description": "Text extraction may locate a value; the digest records it only after reading the page image."},
        "pages_read": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "notes": {"type": "string"}
      }
    },
    "orderable_variants": {
      "type": "array",
      "description": "Suffixes that change behavior (mode, voltage code, threshold, grade).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mpn", "difference", "page"],
        "properties": {
          "mpn": {"type": "string"},
          "difference": {"type": "string"},
          "page": {"$ref": "#/$defs/page"}
        }
      }
    },
    "pins": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pin"}},
    "straps": {"type": "array", "items": {"$ref": "#/$defs/strap"}},
    "abs_max": {"type": "array", "items": {"$ref": "#/$defs/spec"}},
    "recommended_operating": {"type": "array", "items": {"$ref": "#/$defs/spec"}},
    "electrical": {"type": "array", "items": {"$ref": "#/$defs/spec"}, "description": "Thresholds, leakage, timing, drive. Keep the test conditions."},
    "equations": {"type": "array", "items": {"$ref": "#/$defs/equation"}},
    "layout_rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "errata": {"type": "array", "items": {"$ref": "#/$defs/erratum"}},
    "example_envelope": {
      "type": "array",
      "description": "One entry per example or typical-application circuit. Required for regulators; empty for parts with no example circuit.",
      "items": {"$ref": "#/$defs/example"}
    },
    "curves": {"type": "array", "items": {"$ref": "#/$defs/curve"}},
    "not_published": {"type": "array", "items": {"$ref": "#/$defs/not_published"}},
    "conflicts": {
      "type": "array",
      "description": "Places where the document disagrees with itself. Keep every row; the digest uses the one the precedence rule picks (workflow/20_datasheets.md).",
      "items": {"$ref": "#/$defs/conflict"}
    }
  },
  "$defs": {
    "source_unavailable_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "consequence"],
      "description": "Why no document was read. Only for status source_unavailable.",
      "properties": {
        "reason": {"enum": ["no_url", "not_pdf", "download_failed", "offline", "user_said_unavailable", "other"]},
        "detail": {"type": "string", "description": "What was tried: the URL and the response, or what the user said and when."},
        "checks_blocked": {"type": "array", "items": {"type": "string"}, "description": "Checklist items that need this part's data, for example 'ldo#LDO-2'."},
        "consequence": {"type": "string", "description": "What the review does instead, for example 'LDO-1 and LDO-2 stay unknown; ask for the datasheet'."}
      }
    },
    "clock_io": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "pins": {"type": "array", "items": {"type": "string"}},
        "output_type": {"type": "string", "description": "Exact vendor format, including traditional or low-power HCSL and device-specific exceptions."},
        "input_type": {"type": "string"},
        "voh_v": {"$ref": "#/$defs/range"},
        "vol_v": {"$ref": "#/$defs/range"},
        "vod_v": {"$ref": "#/$defs/range"},
        "vcm_v": {"$ref": "#/$defs/range"},
        "receiver_common_mode_v": {"$ref": "#/$defs/range"},
        "frequency_hz": {"$ref": "#/$defs/range"},
        "slew_v_per_s": {"$ref": "#/$defs/range"},
        "coupling": {"type": "string"},
        "conditions": {"type": "string"},
        "page": {"$ref": "#/$defs/page"}
      }
    },
    "jesd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string"},
        "revision": {"type": "string"},
        "encoding": {"type": "string"},
        "m": {"type": "integer", "minimum": 1},
        "np": {"type": "integer", "minimum": 1},
        "l": {"type": "integer", "minimum": 1},
        "f": {"type": "integer", "minimum": 1},
        "k": {"type": "integer", "minimum": 1},
        "e": {"type": "integer", "minimum": 1},
        "sample_rate_hz": {"$ref": "#/$defs/range"},
        "lane_rate_bps": {"$ref": "#/$defs/range"},
        "sysref_mode": {"type": "string"},
        "sysref_coupling": {"type": "string"},
        "setup_s": {"$ref": "#/$defs/range"},
        "hold_s": {"$ref": "#/$defs/range"},
        "conditions": {"type": "string"},
        "page": {"$ref": "#/$defs/page"}
      }
    },
    "model_conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bias_v": {"type": "number"},
        "bias_a": {"type": "number"},
        "temperature_c": {"type": "number"},
        "state": {"type": "string"},
        "reference_plane": {"type": "string"},
        "frequency_range_hz": {"type": "array", "items": {"type": "number"}, "minItems": 2},
        "notes": {"type": "string"}
      }
    },
    "model_reference": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reference to an original file kept in the review folder, never a committed vendor model.",
      "properties": {
        "file": {"type": "string"},
        "url": {"type": "string"},
        "download_date": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "revision": {"type": "string"},
        "mpn": {"type": "string"},
        "conditions": {"$ref": "#/$defs/model_conditions"},
        "port_map": {"type": "object", "additionalProperties": {"type": "string"}},
        "reference_ohm": {"type": "array", "items": {"type": "number"}},
        "applicability": {"type": "string"},
        "checks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "model_unavailable_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "consequence"],
      "properties": {
        "reason": {"type": "string"},
        "tried": {"type": "array", "items": {"type": "string"}},
        "checks": {"type": "array", "items": {"type": "string"}},
        "consequence": {"type": "string"},
        "action": {"type": "string"}
      }
    },
    "model_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mpn", "kind", "unavailable"],
      "properties": {
        "status": {"const": "model_unavailable"},
        "mpn": {"type": "string"},
        "kind": {"enum": ["touchstone", "ibis", "spice"]},
        "required_conditions": {"$ref": "#/$defs/model_conditions"},
        "unavailable": {"$ref": "#/$defs/model_unavailable_detail"}
      }
    },
    "page": {"type": ["integer", "string"], "description": "Page number, or 'Table 26 p.33'."},
    "range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {"type": "number"},
        "typ": {"type": "number"},
        "max": {"type": "number"}
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pin", "name", "type", "page"],
      "properties": {
        "pin": {"type": "string"},
        "name": {"type": "string"},
        "type": {"enum": ["power", "ground", "input", "output", "io", "analog", "open_drain", "config", "nc", "dnc", "other"]},
        "domain": {"type": "string", "description": "Supply pin that sets this pin's levels."},
        "function": {"type": "string"},
        "internal_pull": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direction"],
          "properties": {
            "direction": {"enum": ["up", "down", "none", "unknown"]},
            "min_ohm": {"type": "number"},
            "typ_ohm": {"type": "number"},
            "max_ohm": {"type": "number"}
          }
        },
        "unused": {"type": "string", "description": "What the datasheet says to do with the pin when unused."},
        "page": {"$ref": "#/$defs/page"}
      }
    },
    "strap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pin", "levels", "page"],
      "properties": {
        "pin": {"type": "string"},
        "sampled_when": {"type": "string", "description": "For example 'rising edge of RESET_N'."},
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["level", "setting"],
            "properties": {
              "level": {"type": "string", "description": "For example 'high', 'low', 'mode_2'."},
              "setting": {"type": "string"},
              "network": {"type": "string", "description": "Resistor network the datasheet gives for this level."},
              "v_min": {"type": "number"},
              "v_max": {"type": "number"}
            }
          }
        },
        "software_override": {"type": "string", "description": "Whether a register can change it later, with page."},
        "page": {"$ref": "#/$defs/page"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "unit", "page"],
      "properties": {
        "parameter": {"type": "string"},
        "symbol": {"type": "string"},
        "min": {"type": "number"},
        "typ": {"type": "number"},
        "max": {"type": "number"},
        "relative_limits": {
          "type": "array",
          "description": "Bounds stated against another pin, for example OUT abs max min(VIN + 0.3, 3.6). Leave min or max out when that bound is relative; the expression holds its fixed part too.",
          "items": {"$ref": "#/$defs/relative_limit"}
        },
        "unit": {"type": "string"},
        "conditions": {"type": "string"},
        "guaranteed": {"type": "boolean", "description": "True when the datasheet guarantees the min or max, whether production tested, guaranteed by design, by characterization or by statistical analysis; false when the value is typical only."},
        "basis": {"enum": ["production_tested", "design", "characterization", "statistical", "mixed", "unspecified", "typical"], "description": "How the vendor backs the value, from the table notes. mixed: the notes name several methods (for example design, test or statistical analysis) without saying which row uses which. unspecified: guaranteed, but the notes do not say how. A limit not tested on every part is still guaranteed; a finding that rests on one says so."},
        "page": {"$ref": "#/$defs/page"}
      }
    },
    "relative_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bound", "expression", "references"],
      "properties": {
        "bound": {"enum": ["min", "max"]},
        "expression": {"type": "string", "description": "The limit in the row's unit, written with pin or supply names from this digest, for example 'min(VIN + 0.3, 3.6)' or 'VIN'."},
        "references": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Pins or supplies the expression uses, for example ['VIN']."}
      }
    },
    "equation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expression", "page"],
      "properties": {
        "name": {"type": "string"},
        "expression": {"type": "string"},
        "variables": {"type": "object", "additionalProperties": {"type": "string"}},
        "valid_range": {"type": "string"},
        "page": {"$ref": "#/$defs/page"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "page"],
      "properties": {
        "rule": {"type": "string"},
        "page": {"$ref": "#/$defs/page"}
      }
    },
    "erratum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "page"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "affects": {"type": "string"},
        "workaround": {"type": "string"},
        "document": {"type": "string"},
        "page": {"$ref": "#/$defs/page"}
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "vin_v", "vout_v", "compensation", "page"],
      "allOf": [
        {
          "if": {"required": ["topology"], "properties": {"topology": {"const": "linear"}}},
          "else": {"required": ["fsw_hz"]}
        }
      ],
      "properties": {
        "source": {"type": "string", "description": "Figure or typical-application title."},
        "topology": {"enum": ["switching", "linear"], "description": "linear for an LDO or other linear regulator, which needs no fsw_hz. Left out means switching."},
        "output_setting": {"enum": ["adjustable", "fixed"], "description": "adjustable: an external divider sets VOUT. fixed: the divider is inside the part and the FB or sense pin ties straight to the output, so there is no top resistor to put a Cff across."},
        "vin_v": {"$ref": "#/$defs/range"},
        "vout_v": {"type": "number", "description": "As printed. For a generic fixed-output figure that prints none, the ordered variant's VOUT, said so in notes."},
        "iout_a": {"type": "number"},
        "fsw_hz": {"type": "number"},
        "l_h": {"type": "number"},
        "cout_f": {"type": "number", "description": "Nominal output capacitance as drawn."},
        "cout_note": {"type": "string", "description": "Part types and whether bias derating applies."},
        "compensation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["internal", "external", "unknown"], "description": "The controller's own compensation. internal: inside the part, no COMP pin (LDOs too). external: an R-C network on a COMP or ITH pin. A fixed output is output_setting, not a mode."},
            "values": {"type": "string", "description": "External network, for example 'RITH 6.04k, CITH 1 nF'."},
            "feedback_shaping": {"type": "string", "description": "Parts on an external divider that shape the loop, for example 'Cff 22 pF across R1 (VOUT to FB)'. This is not external compensation; mode stays internal when the part has no COMP pin."}
          }
        },
        "operating_mode": {"type": "string", "description": "For example 'forced continuous', 'pulse skipping', 'burst'."},
        "slew_a_per_s": {"type": "number", "description": "(VIN*Dmax - VOUT)/L at this example, computed. Leave it out when Dmax is not given for this variant or the example is linear."},
        "notes": {"type": "string", "description": "What the figure leaves out or what was filled in, with the page."},
        "page": {"$ref": "#/$defs/page"}
      }
    },
    "curve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "x", "y", "page", "csv"],
      "properties": {
        "name": {"type": "string"},
        "x": {"type": "string", "description": "Quantity and unit."},
        "y": {"type": "string", "description": "Quantity and unit."},
        "conditions": {"type": "string"},
        "csv": {"type": "string", "description": "Path of the digitized CSV next to the digest."},
        "method": {"type": "string", "description": "How it was digitized and the read error."},
        "page": {"$ref": "#/$defs/page"}
      }
    },
    "not_published": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "consequence"],
      "properties": {
        "item": {"type": "string"},
        "why_needed": {"type": "string"},
        "searched": {"type": "string"},
        "consequence": {"enum": ["footprint", "bench_test", "vendor_question", "model"]},
        "action": {"type": "string"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "rows", "used"],
      "properties": {
        "item": {"type": "string", "description": "What disagrees, for example 'abs max table names pin 4 SYNC; the pin table names it MODE'."},
        "rows": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "page"],
            "properties": {
              "text": {"type": "string"},
              "page": {"$ref": "#/$defs/page"}
            }
          }
        },
        "used": {"type": "string", "description": "Which row the digest uses and the precedence rule that picked it."},
        "action": {"type": "string", "description": "The vendor question or check that settles it."}
      }
    }
  }
}
