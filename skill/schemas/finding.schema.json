{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board-review/finding.schema.json",
  "title": "Board review finding",
  "description": "One finding. Every claim cites a pin, net, page or calculator result. A finding is reported only after the refutation pass.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "severity", "block", "failure_mode", "claim", "evidence", "fix", "verification"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "title": {"type": "string", "minLength": 5, "maxLength": 140, "description": "One line: part or net, what fails."},
    "severity": {"enum": ["blocker", "major", "minor", "note"]},
    "block": {"$ref": "#/$defs/block"},
    "instance": {"type": "string", "description": "Which instance of the block, for example 'U9 channel 1, 3V3 rail'."},
    "check": {"type": "string", "description": "Checklist item that produced the finding, for example 'buck_regulator#BR-1'."},
    "failure_mode": {"$ref": "#/$defs/failure_mode"},
    "parts": {"type": "array", "items": {"type": "string"}},
    "nets": {"type": "array", "items": {"type": "string"}},
    "pins": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+\\.[A-Za-z0-9_+-]+$"}, "description": "Designator.pin, for example 'U9.26'."},
    "pages": {"type": "array", "items": {"type": "string"}, "description": "Schematic sheet or page, for example 'Power_1V8_3V3 p.15'."},
    "mpns": {"type": "array", "items": {"type": "string"}},
    "claim": {"type": "string", "minLength": 10, "description": "What is wrong and what fails, in one or two sentences."},
    "mechanism": {"type": "string", "description": "How it fails, when that is not obvious from the claim."},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "calculations": {"type": "array", "items": {"$ref": "#/$defs/calculation"}},
    "not_published": {"type": "array", "items": {"$ref": "#/$defs/not_published"}},
    "fix": {"type": "string", "minLength": 3},
    "bench_test": {"type": "string", "description": "Measurement that settles what paper cannot. Required when not_published is non-empty or the verdict is UNVERIFIABLE."},
    "confidence": {"enum": ["high", "medium", "low"]},
    "verification": {"$ref": "#/$defs/verification"},
    "symptom": {"type": "string", "minLength": 3, "description": "What you would see on the bench or in the field, one short line."},
    "change_type": {"enum": ["bom_only", "layout", "part_change", "firmware", "none"], "description": "What the fix touches: BOM only, layout, a part change, firmware, or nothing."},
    "area": {"type": "string", "minLength": 2, "maxLength": 40, "description": "Area of the board for the report row, for example 'Power' or 'Ethernet'."},
    "status": {"$ref": "#/$defs/status"}
  },
  "allOf": [
    {
      "if": {"required": ["not_published"], "properties": {"not_published": {"minItems": 1}}},
      "then": {"required": ["bench_test"]}
    },
    {
      "if": {"required": ["verification"], "properties": {"verification": {"required": ["status"], "properties": {"status": {"const": "UNVERIFIABLE"}}}}},
      "then": {"required": ["bench_test"]}
    }
  ],
  "$defs": {
    "block": {
      "enum": [
        "buck_regulator", "ldo", "ferrite_lc_filter", "pdn_decoupling", "cascaded_rails",
        "enable_uvlo_sequencing", "resets_supervisors_watchdogs", "clocks_crystals",
        "io_levels_and_domains", "straps_and_boot_pins", "ethernet_phy", "camera_csi",
        "xspi_memory", "protection_tvs", "thermal", "layout", "netlist_integrity", "other"
      ]
    },
    "failure_mode": {
      "enum": [
        "loop_instability", "reverse_current", "back_power", "lc_resonance",
        "insufficient_capacitance", "saturation", "dropout", "threshold_margin",
        "level_mismatch", "leakage", "abs_max", "strap_conflict", "boot_mode",
        "reset_hazard", "sequencing", "wrong_value", "net_short", "open_net",
        "missing_sheet", "pin_swap", "missing_pullup", "timing_margin", "clock_fault",
        "protection_gap", "thermal_overstress", "footprint_mismatch",
        "mechanical_interference", "signal_integrity", "missing_rework_option", "other"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["netlist", "bom", "variant", "pcb", "datasheet", "errata", "app_note", "calculator", "simulation", "bench", "lint", "compare", "design_notes"]},
        "ref": {"type": "string", "minLength": 2, "description": "Document number, revision and page; net name; calculator module; or file and line."},
        "detail": {"type": "string"}
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calculator", "formula", "inputs", "outputs", "verdict"],
      "properties": {
        "calculator": {"type": "string", "description": "Calculator module and function relative to the boardreview package, for example 'calc.lc_tank.lc_filter'."},
        "formula": {"type": "string"},
        "inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/quantity"}},
        "outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/quantity"}},
        "verdict": {"enum": ["pass", "marginal", "fail", "info", "unknown"]},
        "reason": {"type": "string"},
        "assumptions": {"type": "array", "items": {"type": "string"}},
        "refs": {"type": "array", "items": {"type": "string"}},
        "plots": {"type": "array", "items": {"$ref": "#/$defs/plot"}}
      }
    },
    "plot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "x", "series"],
      "description": "Result.plots[i].to_dict(): shared x, y series grouped into one panel per unit, marked points.",
      "properties": {
        "title": {"type": "string"},
        "x": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "unit", "values"],
          "properties": {
            "label": {"type": "string"},
            "unit": {"type": "string"},
            "log": {"type": "boolean"},
            "values": {"type": "array", "items": {"type": ["number", "null"]}}
          }
        },
        "y_log": {"type": "boolean"},
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "unit", "values"],
            "properties": {
              "label": {"type": "string"},
              "unit": {"type": "string"},
              "values": {"type": "array", "items": {"type": ["number", "null"]}}
            }
          }
        },
        "markers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label"],
            "description": "x and y: a point; x only: a vertical line; y only: a horizontal limit line. unit picks the panel.",
            "properties": {
              "label": {"type": "string"},
              "x": {"type": ["number", "null"]},
              "y": {"type": ["number", "null"]},
              "unit": {"type": "string"}
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fix tracking. fixed is set by a person; verified_in_data only by a re-review that finds the fix in the netlist or BOM.",
      "properties": {
        "fixed": {"type": "boolean"},
        "fixed_at": {"type": "string"},
        "fixed_by": {"type": "string"},
        "verified_in_data": {"type": "boolean", "description": "true: the re-review found the fix in the data; false: it looked and did not. Absent: not checked, or needs a reviewer."},
        "verify_note": {"type": "string"},
        "verified_at": {"type": "string"}
      }
    },
    "not_published": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "consequence"],
      "properties": {
        "item": {"type": "string", "description": "The value the documents do not give, for example 'internal compensation network'."},
        "searched": {"type": "string", "description": "Where it was looked for."},
        "consequence": {"enum": ["footprint", "bench_test", "vendor_question", "model"]},
        "action": {"type": "string"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["CONFIRMED", "WRONG", "UNVERIFIABLE", "PENDING"]},
        "by": {"type": "string"},
        "notes": {"type": "string"},
        "sources_checked": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
